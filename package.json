{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist-server/server.cjs",
    "clean": "rm -rf dist dist-server",
    "lint": "tsc --noEmit",
    "test:python": "python3 -m unittest tests/test_pipeline.py",
    "test:engine": "tsx --test server/tests/engine.test.ts",
    "test:report": "tsx --test server/tests/report.test.ts",
    "build:server": "node scripts/build-server.mjs",
    "verify:runtime": "node scripts/check-runtime-files.mjs",
    "verify:build": "node scripts/check-runtime-files.mjs --build",
    "test:python:core": "python3 -m unittest tests.test_drift_lagrangian tests.test_dataset_loader tests.test_training_guard tests.test_baseline_integrity tests.test_evaluation_protocol tests.test_data_manifest tests.test_extensions tests.test_data_root_and_cache tests.test_compare_candidate",
    "test:agents": "tsx --test server/tests/agents.test.ts",
    "test:ts": "tsx --test server/tests/engine.test.ts server/tests/report.test.ts server/tests/agents.test.ts",
    "verify:baseline": "python3 ml/verification/verify_baseline.py --reproduce"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.4.16",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
