# Build context for Dockerfile (web) and Dockerfile.api (FastAPI).
# Secrets and local environments
.env
.env.*
!.env.example
.git
.venv
venv
env
# Dependencies and build output (rebuilt inside the image)
node_modules
dist
dist-server
.vite
coverage
*.tsbuildinfo
# Caches and OS files
**/__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.DS_Store
*.log
# Training data and experiments are never part of an image
ml/datasets/radar_data
ml/datasets/*.rar
ml/checkpoints/candidates
# Large files not needed at runtime (runtime data: data/sample, data/ais/2018,
# data/era5, data/sentinel1/derived; verified by scripts/check-runtime-files.mjs)
ml/results/overlays
data/sentinel1/event_predictions
data/sentinel1/*.png
data/sentinel1/S1A_*.tif

# Large research artifacts that are NOT copied into either image (keeps the build context small).
# These are git-ignored too, so they are never in Render's build context either.
# NOTE: backend/ and tests/ are deliberately NOT excluded — Dockerfile.api copies backend/, and
# .dockerignore applies to every Dockerfile built from this context.
ml/results/inference/*/unet_probability_*.tif
ml/results/inference/*/unet_mask_*.tif
data/sentinel1/copernicus_*.tif
PACKAGE_SHA256SUMS.txt
