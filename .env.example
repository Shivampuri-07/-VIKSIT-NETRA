# ==============================================================================
# Environment Configuration - Sentinel-1 Oil Spill Detection & Attribution
# ==============================================================================

# Application Mode: 'DEMO' (default, uses local realistic sample data) or 'REAL' (uses live APIs)
APP_MODE=DEMO

# Server Configuration (read by the Express server: server.ts)
# NODE_ENV=production is implied by `npm start` (compiled bundle).
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=INFO

# NOT read by any current component (kept for the legacy FastAPI backend configuration)
# Database URL (defaults to local SQLite database)
DATABASE_URL=sqlite:///./data/oil_spill.db

# ------------------------------------------------------------------------------
# Model & Attribution Configuration (Defaults provided for instant local execution)
# ------------------------------------------------------------------------------
# NOT read by any current component: ranking weights are set in the UI (Weights dialog)
WEIGHT_SPATIAL=0.35
WEIGHT_TEMPORAL=0.25
WEIGHT_TRAJECTORY=0.25
WEIGHT_CONSISTENCY=0.15

# NOT read by any current component: drift parameters are set in the UI (Drift dialog)
DRIFT_WIND_FACTOR=0.03
DRIFT_EDDY_DIFFUSIVITY=2.5

# ------------------------------------------------------------------------------
# Optional Live API Credentials (ONLY required when APP_MODE=REAL)
# In DEMO mode (default), these are NOT required and the app uses bundled data.
# ------------------------------------------------------------------------------
# 1. Copernicus Data Space Ecosystem (Sentinel-1 SAR Imagery)
# Free registration: https://dataspace.copernicus.eu/
# COPERNICUS_USERNAME=
# COPERNICUS_PASSWORD=
# COPERNICUS_CLIENT_ID=
# COPERNICUS_CLIENT_SECRET=

# 2. Copernicus Marine Service (Ocean Currents - uo, vo)
# Free registration: https://marine.copernicus.eu/
# COPERNICUS_MARINE_USERNAME=
# COPERNICUS_MARINE_PASSWORD=

# 3. Copernicus Climate Data Store (CDS) / ERA5 (10m Wind - u10, v10)
# Free registration: https://cds.climate.copernicus.eu/
# CDS_API_URL=https://cds.climate.copernicus.eu/api/v2
# CDS_API_KEY=

# 4. MarineCadastre / AccessAIS (AIS Broadcast Points)
# Public bulk download / API: https://marinecadastre.gov/ais/
# AIS_DATA_DIR=./data/raw/ais
# ------------------------------------------------------------------------------
# CARTO Basemap
# ------------------------------------------------------------------------------
# Optional. Leave EMPTY to use CARTO's public dark basemap (no key needed).
# WARNING: every VITE_* variable is compiled INTO the public browser bundle at
# build time. Only use a CARTO key restricted to your deployment domain.
VITE_CARTO_API_KEY=
# ------------------------------------------------------------------------------
# Production hardening (Express server)
# ------------------------------------------------------------------------------
# Maximum concurrent drift/investigation jobs before HTTP 429 (default 2)
# AEGIS_MAX_CONCURRENT_JOBS=2
# Set to 1 only if the UI must be embedded in an iframe (default: X-Frame-Options DENY)
# AEGIS_ALLOW_FRAMING=0

# ------------------------------------------------------------------------------
# Legacy FastAPI backend (optional; the web UI does not use it)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed browser origins
# CORS_ALLOW_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# External data root (large original data: labelled Radar_data, real 2018-09-26 SAR scene, ERA5, AIS).
# Never copied into this repository. Point it at the folder that contains ml/datasets/radar_data/ and Data/.
# Leave unset to use only the repository-local data/ directory.
# AEGIS_DATA_ROOT=/path/to/AEGIS-Sentinel-Oil-Spill-main 3

# ------------------------------------------------------------------------------
# SAR image upload (POST /api/uploads/sar) and live re-inference of the demo scene
# (POST /api/demo/verify-inference) - both score a raster with the frozen U-Net.
# Needs python3 with torch + rasterio (see requirements-inference.txt). Without it the endpoints
# report MODEL_RUNTIME_UNAVAILABLE instead of inventing a result; /api/health shows which.
# AEGIS_PYTHON=python3
# AEGIS_UPLOAD_DIR=/tmp/viksit-netra-uploads
# AEGIS_MAX_UPLOAD_BYTES=314572800
# AEGIS_UPLOAD_TIMEOUT_MS=600000

# ==============================================================================
# Render Free deployment (ACTIVE TARGET - see RENDER_DEPLOYMENT.md)
# ==============================================================================
# REQUIRED for the judge demonstration: NOTHING. The demo is fully self-contained.
# Do not paste any secret into the Render dashboard for this deployment.
#
# Render injects PORT itself and the Dockerfile sets HOST=0.0.0.0, so neither is set here.
#
# OPTIONAL (already set by render.yaml; safe to leave alone):
#   NODE_ENV=production
#   AEGIS_MAX_CONCURRENT_JOBS=1          # 1 suits a 0.1-CPU free instance
#   AEGIS_UPLOAD_DIR=/tmp/viksit-netra-uploads
#
# NOT NEEDED FOR THE DEMO (leave every one of these unset):
#   COPERNICUS_*, CDS_API_KEY, AIS_DATA_DIR, DATABASE_URL, AEGIS_DATA_ROOT,
#   CARTO_API_KEY / VITE_CARTO_API_KEY
# Each has a working fallback: the map uses CARTO's public basemap without a key, and the
# application reads only the data bundled into the image.
#
# On Render Free (512 MB RAM) the image is built WITHOUT the PyTorch runtime, so the SAR upload
# and "Verify detection" endpoints report MODEL_RUNTIME_UNAVAILABLE and the UI labels the
# detection PRECOMPUTED DEMO RESULT. Nothing is fabricated. To run the model live, deploy to a
# host with >= 2 GB RAM using: docker build --build-arg WITH_MODEL_RUNTIME=true
# Those builds also set thread caps in the Dockerfile:
#   OMP_NUM_THREADS=2
#   MKL_NUM_THREADS=2
